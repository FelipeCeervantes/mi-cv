---
interface Props {
  nombre: string;
}
const { nombre } = Astro.props;
---
<span class="badge">{nombre}</span>

<style>
  .badge {
    display: inline-block;
    background: #e0e7ff;
    color: #1d3fae;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.85rem;
    margin: 0 0.4rem 0.4rem 0;
  }
</style>
